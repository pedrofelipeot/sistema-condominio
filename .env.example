# Banco da aplicação (runtime) e conexão direta usada pelo Prisma CLI.
# Substitua os placeholders por conexões do seu banco de desenvolvimento.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=require"

# Gere segredos próprios para cada ambiente. Não reutilize estes exemplos.
SESSION_SECRET="troque-por-um-segredo-aleatorio-longo"
CRON_SECRET="troque-por-outro-segredo-aleatorio-longo"

# URL pública usada para links de convite e metadata.
APP_URL="http://localhost:3000"

# Configure as três variáveis juntas para habilitar pagamentos via Pix.
PIX_CHAVE="chave-pix-de-desenvolvimento"
PIX_NOME_RECEBEDOR="Condominio Exemplo"
PIX_CIDADE="Sao Paulo"

# Usadas por `npm run db:seed` para criar o administrador e moradores de teste.
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="troque-esta-senha-de-desenvolvimento"
SEED_MORADOR_PASSWORD="troque-esta-senha-de-desenvolvimento"
# Só use true com um banco descartável: o seed apagará dados de moradores e cobranças.
SEED_RESET="false"

# Salvaguarda para testes que limpam o banco. Mantenha false neste arquivo.
# Os testes exigem um .env.test separado, com banco isolado e ALLOW_DB_RESET=true.
ALLOW_DB_RESET="false"
